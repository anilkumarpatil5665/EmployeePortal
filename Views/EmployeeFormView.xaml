<UserControl x:Class="EmployeePortal.Views.EmployeeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#444444"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="0,5,15,0"/>

        </Style>

        <Style x:Key="RoundedTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="5,5,10,0"/>

            <Setter Property="Margin"
                    Value="0,5"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D0D0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ============================= -->
        <!-- ComboBox Style                 -->
        <!-- ============================= -->

        <Style x:Key="FormComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Margin"
                    Value="0,5"/>

            <Setter Property="Padding"
                    Value="8,0"/>

            <Setter Property="BorderBrush"
                    Value="#D0D0D0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ============================= -->
        <!-- Button Style                   -->
        <!-- ============================= -->

        <Style x:Key="FormButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="35"/>

            <Setter Property="Width"
                    Value="90"/>

            <Setter Property="Margin"
                    Value="5,0"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

    </UserControl.Resources>


    <!-- ================================= -->
    <!-- Main Form                         -->
    <!-- ================================= -->

    <Border Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="10"
            Padding="25">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================= -->
            <!-- Title                             -->
            <!-- ================================= -->

            <TextBlock Grid.Row="0"
                       Text="Add New Employee"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#222222"
                       Margin="0,0,0,5"/>


            <!-- ================================= -->
            <!-- Error Message                     -->
            <!-- ================================= -->

            <TextBlock Grid.Row="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="#D32F2F"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>


            <!-- ================================= -->
            <!-- Form Fields                       -->
            <!-- ================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="120"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================= -->
                <!-- Name                              -->
                <!-- ================================= -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Name"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.Name,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Address                           -->
                <!-- ================================= -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Address"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.Address,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Gender                            -->
                <!-- ================================= -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Gender"
                           Style="{StaticResource FormLabelStyle}"/>

                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          ItemsSource="{Binding GenderOptions}"
                          SelectedItem="{Binding NewEmployee.Gender,
                                                 Mode=TwoWay}"
                          Style="{StaticResource FormComboBoxStyle}"/>


                <!-- ================================= -->
                <!-- Married                           -->
                <!-- ================================= -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Married"
                           Style="{StaticResource FormLabelStyle}"/>

                <CheckBox Grid.Row="3"
                          Grid.Column="1"
                          IsChecked="{Binding NewEmployee.IsMarried,
                                              Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,5"/>


                <!-- ================================= -->
                <!-- Phone                             -->
                <!-- ================================= -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Phone"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.PhoneNumber,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Email                             -->
                <!-- ================================= -->

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Email"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.Email,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Position                          -->
                <!-- ================================= -->

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Position"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.Position,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Reporting To                      -->
                <!-- ================================= -->

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Reporting To"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.ReportingTo,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Project                           -->
                <!-- ================================= -->

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Project"
                           Style="{StaticResource FormLabelStyle}"/>

                <TextBox Grid.Row="8"
                         Grid.Column="1"
                         Text="{Binding NewEmployee.ProjectName,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBoxStyle}"/>


                <!-- ================================= -->
                <!-- Photo                             -->
                <!-- ================================= -->

                <TextBlock Grid.Row="9"
                           Grid.Column="0"
                           Text="Photo"
                           Style="{StaticResource FormLabelStyle}"/>

                <StackPanel Grid.Row="9"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Photo preview -->

                    <Border Width="100"
                            Height="70"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,5,10,5">

                        <Image Stretch="Uniform"/>

                    </Border>


                    <!-- Browse -->

                    <Button Content="Browse"
                            Command="{Binding BrowsePhotoCommand}"
                            Width="90"
                            Height="32"
                            VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>


            <!-- ================================= -->
            <!-- Buttons                           -->
            <!-- ================================= -->

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Cancel"
                        Command="{Binding CancelEmployeeCommand}"
                        Style="{StaticResource FormButtonStyle}"/>

                <Button Content="Save"
                        Command="{Binding SaveEmployeeCommand}"
                        Style="{StaticResource FormButtonStyle}"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>