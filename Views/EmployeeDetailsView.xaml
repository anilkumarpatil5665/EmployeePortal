<UserControl x:Class="EmployeePortal.Views.EmployeeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EmployeePortal.Converters">

    <UserControl.Resources>

        <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>

        <!-- Common style for detail labels -->
        <Style x:Key="DetailLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#666666"/>

            <Setter Property="Margin"
                    Value="5, 8"/>

        </Style>

        <!-- Common style for detail values -->
        <Style x:Key="DetailValueStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#333333"/>

            <Setter Property="Margin"
                    Value="5, 8"/>

        </Style>

    </UserControl.Resources>


    <Grid>

        <!-- ============================= -->
        <!-- Empty state                    -->
        <!-- ============================= -->

        <Border Margin="20"
                Padding="20">

            <Border.Style>

                <Style TargetType="Border">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding HasSelectedEmployee}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>

            <TextBlock Text="Select an employee to view details"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>


        <!-- ============================= -->
        <!-- Employee details               -->
        <!-- ============================= -->

        <Border Margin="20"
                Padding="20">

            <Border.Style>

                <Style TargetType="Border">

                    <!-- Hidden initially -->
                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>

                        <!-- Show when employee is selected -->
                        <DataTrigger Binding="{Binding HasSelectedEmployee}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>


            <Grid>

                <Grid.RowDefinitions>

                    <!-- Employee Details title -->
                    <RowDefinition Height="Auto"/>

                    <!-- Employee header -->
                    <RowDefinition Height="Auto"/>

                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>

                    <!-- Employee information -->
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ============================= -->
                <!-- Title                           -->
                <!-- ============================= -->

                <TextBlock Grid.Row="0"
                           Text="Employee Details"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#222222"
                           Margin="0,0,0,20"/>


                <!-- ============================= -->
                <!-- Employee header                 -->
                <!-- ============================= -->

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,20">


                    <!-- Photo -->

                    <Border Width="100"
                            Height="100"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="5">

                        <Image Width="100"
                               Height="100"
                               Stretch="Uniform"/>

                    </Border>


                    <!-- Name / Position / Project -->

                    <StackPanel Margin="20,5,0,0">

                        <TextBlock Text="{Binding SelectedEmployee.Name}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#222222"/>

                        <TextBlock Text="{Binding SelectedEmployee.Position}"
                                   FontSize="16"
                                   Foreground="#666666"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding SelectedEmployee.ProjectName}"
                                   FontSize="14"
                                   Foreground="#888888"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>


                <!-- ============================= -->
                <!-- Separator                       -->
                <!-- ============================= -->

                <Border Grid.Row="2"
                        Height="1"
                        Background="#DDDDDD"
                        Margin="0,0,0,15"/>


                <!-- ============================= -->
                <!-- Employee information            -->
                <!-- ============================= -->

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="120"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- Address -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Address"
                               Style="{StaticResource DetailLabelStyle}"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding SelectedEmployee.Address}"
                               Style="{StaticResource DetailValueStyle}"
                               TextWrapping="Wrap"/>


                    <!-- Gender -->

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Gender"
                               Style="{StaticResource DetailLabelStyle}"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding SelectedEmployee.Gender}"
                               Style="{StaticResource DetailValueStyle}"/>


                    <!-- Married -->

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Married"
                               Style="{StaticResource DetailLabelStyle}"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding SelectedEmployee.IsMarried,
                                      Converter={StaticResource BoolToYesNoConverter}}"
                               Style="{StaticResource DetailValueStyle}"/>


                    <!-- Phone -->

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Phone"
                               Style="{StaticResource DetailLabelStyle}"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{Binding SelectedEmployee.PhoneNumber}"
                               Style="{StaticResource DetailValueStyle}"/>


                    <!-- Email -->

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Email"
                               Style="{StaticResource DetailLabelStyle}"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{Binding SelectedEmployee.Email}"
                               Style="{StaticResource DetailValueStyle}"/>


                    <!-- Reporting To -->

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Reporting To"
                               Style="{StaticResource DetailLabelStyle}"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="{Binding SelectedEmployee.ReportingTo}"
                               Style="{StaticResource DetailValueStyle}"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>